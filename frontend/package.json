{
  "name": "vue-element-plus-admin",
  "version": "3.1.0",
  "description": "一套基于vue3、element-plus、typesScript、vite4的后台集成方案。",
  "author": "Archer <502431556@qq.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "i": "pnpm install",
    "dev:admin": "pnpm --filter @vea/admin dev",
    "build:admin": "pnpm --filter @vea/admin build",
    "build:admin:dev": "pnpm --filter @vea/admin build:dev",
    "build:admin:test": "pnpm --filter @vea/admin build:test",
    "preview:admin": "pnpm --filter @vea/admin preview",
    "typecheck:admin": "pnpm --filter @vea/admin ts:check",
    "typecheck": "pnpm typecheck:admin && pnpm --filter @vea/components typecheck && pnpm --filter @vea/hooks typecheck && pnpm --filter @vea/request typecheck",
    "clean:admin": "pnpm --filter @vea/admin clean",
    "dev:docs": "pnpm --filter @vea/docs dev",
    "build:docs": "pnpm --filter @vea/docs build",
    "preview:docs": "pnpm --filter @vea/docs preview",
    "npm:check": "pnpx npm-check-updates -u",
    "clean": "rimraf node_modules",
    "clean:cache": "rimraf node_modules/.cache",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format:check": "prettier --check --ignore-unknown .",
    "lint:format": "prettier --write --ignore-unknown --log-level warn .",
    "style:check": "stylelint \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "lint:style": "stylelint --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "autoprefixer": "^10.6.1",
    "esno": "^4.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.30",
    "postcss-html": "^2.0.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.10",
    "rimraf": "catalog:",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.15.3",
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "eslint",
        "search-insights"
      ]
    },
    "overrides": {
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "postcss-selector-parser@<7.1.6": "7.1.6",
      "probe-image-size@<=7.3.0": "7.4.0",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "vitepress>vite": "6.4.3",
      "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
      "colord@<2.9.4": "2.9.4",
      "vue@>=3.0.0 <3.5.42": "3.5.42"
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "pnpm": ">=9.5.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kailong321200875/vue-element-plus-admin.git"
  },
  "bugs": {
    "url": "https://github.com/kailong321200875/vue-element-plus-admin/issues"
  },
  "homepage": "https://github.com/kailong321200875/vue-element-plus-admin"
}
