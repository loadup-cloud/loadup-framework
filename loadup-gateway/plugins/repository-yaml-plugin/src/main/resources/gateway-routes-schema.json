{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loadup-cloud.github.io/schemas/gateway-routes.json",
  "title": "LoadUp managed gateway routes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "routes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "routes": { "type": "array", "items": { "$ref": "#/$defs/route" } }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "path", "methods", "target", "access"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer" },
        "path": { "type": "string", "pattern": "^/api/" },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "TRACE"] }
        },
        "target": { "$ref": "#/$defs/target" },
        "access": { "$ref": "#/$defs/access" },
        "filters": { "type": "array", "items": { "$ref": "#/$defs/filter" } }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "bean", "method"],
          "properties": {
            "type": { "const": "service" },
            "bean": { "type": "string", "minLength": 1 },
            "method": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "uri"],
          "properties": {
            "type": { "const": "http" },
            "uri": { "type": "string", "pattern": "^(https?://|lb://)" }
          }
        }
      ]
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["public", "authenticated", "authority"] },
        "anyOf": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "signature": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "authority" } } },
          "then": { "required": ["anyOf"] },
          "else": { "not": { "required": ["anyOf"] } }
        }
      ]
    },
    "filter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "args"],
          "properties": {
            "name": { "const": "StripPrefix" },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": ["parts"],
              "properties": { "parts": { "type": "integer", "minimum": 0 } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "args"],
          "properties": {
            "name": { "const": "CircuitBreaker" },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": { "name": { "type": "string", "minLength": 1 } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "args"],
          "properties": {
            "name": { "const": "RewritePath" },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": ["regexp", "replacement"],
              "properties": {
                "regexp": { "type": "string", "minLength": 1 },
                "replacement": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "args"],
          "properties": {
            "name": { "const": "SetRequestHeader" },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "value": { "type": "string" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "args"],
          "properties": {
            "name": { "const": "RateLimit" },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": ["capacity", "periodSeconds"],
              "properties": {
                "capacity": { "type": "integer", "minimum": 1 },
                "periodSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
                "key": { "enum": ["ip", "principal"] }
              }
            }
          }
        }
      ]
    }
  }
}
