{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loadup-cloud.github.io/schemas/gateway-routes.json",
  "title": "LoadUp Gateway Routes",
  "description": "Schema for gateway-routes.yml — LoadUp Gateway route configuration.",
  "type": "object",
  "properties": {
    "routes": {
      "type": "array",
      "description": "List of route definitions.",
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "required": ["routes"],
  "$defs": {
    "route": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique route identifier (auto-generated if omitted)."
        },
        "path": {
          "type": "string",
          "description": "URL path pattern. Supports Ant-style: /api/user/{id}, /api/**"
        },
        "method": {
          "type": "string",
          "description": "HTTP method.",
          "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"],
          "default": "POST"
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether this route is active.",
          "default": true
        },
        "securityCode": {
          "type": "string",
          "description": "Security strategy code.",
          "enum": ["OFF", "default", "signature", "internal"],
          "default": "default"
        },
        "timeout": {
          "type": "integer",
          "description": "Route-level timeout in milliseconds."
        },
        "wrapResponse": {
          "type": "boolean",
          "description": "Whether to wrap response in {result, data, meta} envelope."
        },
        "backend": { "$ref": "#/$defs/backend" },
        "filters": {
          "type": "array",
          "description": "Ordered request-phase filters.",
          "items": { "$ref": "#/$defs/filter" }
        },
        "responseFilters": {
          "type": "array",
          "description": "Ordered response-phase filters (run after backend call).",
          "items": { "$ref": "#/$defs/filter" }
        }
      },
      "required": ["path", "backend"]
    },
    "backend": {
      "type": "object",
      "description": "Backend target configuration.",
      "properties": {
        "protocol": {
          "type": "string",
          "description": "Backend protocol.",
          "enum": ["http", "bean", "rpc"]
        },
        "url": {
          "type": "string",
          "description": "Target URL (for http/rpc protocol)."
        },
        "beanName": {
          "type": "string",
          "description": "Spring bean name (for bean protocol)."
        },
        "methodName": {
          "type": "string",
          "description": "Method name on the bean (for bean protocol)."
        }
      },
      "required": ["protocol"]
    },
    "filter": {
      "type": "object",
      "description": "A named filter with optional properties.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Filter name matching a registered GatewayFilter bean.",
          "enum": [
            "body-parser",
            "rate-limit",
            "security",
            "circuit-breaker",
            "response-wrapper"
          ]
        },
        "props": {
          "type": "object",
          "description": "Filter-specific key-value parameters.",
          "properties": {
            "capacity": {
              "type": "integer",
              "description": "[rate-limit] Max burst capacity."
            },
            "refillRate": {
              "type": "number",
              "description": "[rate-limit] Tokens per second."
            },
            "failureThreshold": {
              "type": "integer",
              "description": "[circuit-breaker] Consecutive failures to open circuit."
            },
            "openTimeout": {
              "type": "integer",
              "description": "[circuit-breaker] Seconds to stay open before half-open."
            },
            "halfOpenMax": {
              "type": "integer",
              "description": "[circuit-breaker] Max requests in half-open state."
            },
            "successThreshold": {
              "type": "integer",
              "description": "[circuit-breaker] Consecutive successes to close circuit."
            },
            "scopes": {
              "type": "array",
              "items": { "type": "string" },
              "description": "[security] Required OAuth scopes."
            }
          }
        }
      },
      "required": ["name"]
    }
  }
}
