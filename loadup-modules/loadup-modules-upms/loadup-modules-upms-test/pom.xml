        </dependency>
        <dependency>
            <groupId>io.github.loadup-cloud</groupId>
            <artifactId>loadup-modules-upms-infrastructure</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.loadup-cloud</groupId>
            <artifactId>loadup-modules-upms-app</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Database Component -->
        <dependency>
            <groupId>io.github.loadup-cloud</groupId>
            <artifactId>loadup-components-database</artifactId>
            <scope>test</scope>
        </dependency>

