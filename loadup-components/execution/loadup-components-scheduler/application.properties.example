# LoadUp Scheduler Configuration Examples

## JobRunr Binder (recommended, shared with retrytask)
# Add dependency: loadup-components-scheduler-binder-jobrunr
jobrunr.background-job-server.enabled=true
jobrunr.background-job-server.poll-interval-in-seconds=15
jobrunr.background-job-server.worker-count=4
jobrunr.dashboard.enabled=true
jobrunr.dashboard.username=admin
jobrunr.dashboard.password=change-me

## Quartz Binder (embedded)
# Add dependency: loadup-components-scheduler-binder-quartz
spring.quartz.job-store-type=memory
# spring.quartz.job-store-type=jdbc
spring.quartz.properties.org.quartz.scheduler.instanceName=LoadUpScheduler
spring.quartz.properties.org.quartz.scheduler.instanceId=AUTO
spring.quartz.properties.org.quartz.threadPool.threadCount=10
