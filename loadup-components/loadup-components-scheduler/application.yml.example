# LoadUp Scheduler Configuration Examples

# ==================== JobRunr Binder (recommended, shared with retrytask) ====================
# Add dependency: loadup-components-scheduler-binder-jobrunr
jobrunr:
  background-job-server:
    enabled: true
    poll-interval-in-seconds: 15
    worker-count: 4
  dashboard:
    enabled: true
    username: admin
    password: change-me

# ==================== Quartz Binder (embedded) ====================
# Add dependency: loadup-components-scheduler-binder-quartz
spring:
  quartz:
    # In-Memory Store (Development)
    job-store-type: memory

    # JDBC Store (Production - Cluster Support)
    # job-store-type: jdbc
    # jdbc:
    #   initialize-schema: always

    properties:
      org.quartz.scheduler.instanceName: LoadUpScheduler
      org.quartz.scheduler.instanceId: AUTO
      org.quartz.threadPool.threadCount: 10
