processor.enable = true
processor.stopBubbling = true
processor.charset = UTF-8
processor.allInTables.enable = true
processor.allInTables.className = Tables
processor.allInTables.package = ${entityPackage.parent}.table
processor.mapper.generateEnable = true
processor.mapper.annotation = true
processor.mapper.baseClass = com.mybatisflex.core.BaseMapper
processor.mapper.package = ${entityPackage.parent}.mapper
processor.tableDef.package = ${entityPackage.parent}.table
processor.tableDef.propertiesNameStyle = upperCase
processor.tableDef.classSuffix = TableDef
processor.tableDef.instanceSuffix =
processor.tableDef.ignoreEntitySuffixes = DO
