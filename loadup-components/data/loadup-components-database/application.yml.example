loadup:
  database:
    audit:
      enabled: true
    id-generator:
      enabled: true
      strategy: random
      random-length: 20
      uuid-with-hyphens: false
      snowflake-worker-id: 0
      snowflake-datacenter-id: 0
    logical-delete:
      enabled: true
      column-name: deleted
      normal-value: 0
      deleted-value: 1
    multi-tenant:
      enabled: true
      required: true
      column-name: tenant_id
      default-tenant-id:
      ignore-tables:
        - sys_tenant
        - sys_config
      request:
        header-name: X-Tenant-Id
        parameter-name: tenantId
        subdomain-enabled: false
        excluded-subdomains:
          - www
          - api

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/application?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=UTC
    username: application
    password: change-me
    driver-class-name: com.mysql.cj.jdbc.Driver

logging:
  level:
    io.github.loadup.components.database: INFO
