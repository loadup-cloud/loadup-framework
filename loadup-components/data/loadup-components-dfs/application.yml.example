loadup:
  dfs:
    # Add exactly one binder dependency and select the same binder here.
    binder-type: s3
    binder:
      s3:
        bucket: loadup-files
        region: us-east-1
        endpoint: https://s3.amazonaws.com
        access-key: ${AWS_ACCESS_KEY_ID:}
        secret-key: ${AWS_SECRET_ACCESS_KEY:}
        key-prefix: objects
        path-style-access-enabled: false
        create-bucket: false
