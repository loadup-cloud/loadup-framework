    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>component-execution-data</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <phase>post-integration-test</phase>
                        <configuration>
                            <!-- Do not inherit the unrelated dependency-ban skip switch. -->
                            <skip>false</skip>
                            <rules>
                                <requireFilesSize>
                                    <minsize>1</minsize>
                                    <files>
                                        <!-- One file per current component test suite kind.
                                             Add entries when adding unit tests or ITs to another module. -->
                                        <file>${maven.multiModuleProjectDirectory}/loadup-components/data/loadup-components-cache/loadup-components-cache-test/target/jacoco-unit.exec</file>
                                        <file>${maven.multiModuleProjectDirectory}/loadup-components/data/loadup-components-cache/loadup-components-cache-test/target/jacoco-it.exec</file>
                                        <file>${maven.multiModuleProjectDirectory}/loadup-components/data/loadup-components-database/target/jacoco-unit.exec</file>
