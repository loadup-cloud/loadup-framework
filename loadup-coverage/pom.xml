                                        <file>${maven.multiModuleProjectDirectory}/loadup-components/integration/loadup-components-gotone/loadup-components-gotone-test/target/jacoco-unit.exec</file>
                                        <file>${maven.multiModuleProjectDirectory}/loadup-components/integration/loadup-components-gotone/loadup-components-gotone-test/target/jacoco-it.exec</file>
                                        <file>${maven.multiModuleProjectDirectory}/loadup-components/integration/loadup-components-http/target/jacoco-unit.exec</file>
                                        <file>${maven.multiModuleProjectDirectory}/loadup-components/platform/loadup-components-configcenter/loadup-components-configcenter-test/target/jacoco-unit.exec</file>
                                        <file>${maven.multiModuleProjectDirectory}/loadup-components/platform/loadup-components-configcenter/loadup-components-configcenter-test/target/jacoco-it.exec</file>
                                        <file>${maven.multiModuleProjectDirectory}/loadup-components/platform/loadup-components-extension/target/jacoco-unit.exec</file>
                                        <file>${maven.multiModuleProjectDirectory}/loadup-components/platform/loadup-components-observability/target/jacoco-unit.exec</file>
                                        <file>${maven.multiModuleProjectDirectory}/loadup-components/platform/loadup-components-observability/target/jacoco-it.exec</file>
