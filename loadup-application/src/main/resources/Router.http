{{upmsDepartmentId}}

# Resource-level ABAC has no HTTP endpoint; call AccessCheckService from trusted application code.

### Query recent audit events (requires ROLE_SUPER_ADMIN)
POST {{baseUrl}}/api/audit/events/query
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"page": 1, "size": 20}

### Upload a file (business references are managed by application code)
POST {{baseUrl}}/api/files
Authorization: Bearer {{upmsAccessToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="sample.txt"
Content-Type: text/plain

Hello LoadUp
--boundary--

> {%
  client.global.set("fileResourceId", response.body.data.id);
%}

### List my files
POST {{baseUrl}}/api/files/list
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"page": 1, "size": 20}

### Read file metadata
POST {{baseUrl}}/api/files/detail
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"id": "{{fileResourceId}}"}

### Download file content (binary response)
GET {{baseUrl}}/api/files/{{fileResourceId}}/content
Authorization: Bearer {{upmsAccessToken}}

### Read file references
POST {{baseUrl}}/api/files/references
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"id": "{{fileResourceId}}"}

### Delete unreferenced file
POST {{baseUrl}}/api/files/delete
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"id": "{{fileResourceId}}"}

### Retry pending file deletions (requires ROLE_SUPER_ADMIN)
POST {{baseUrl}}/api/files/cleanup
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"limit": 100}

### Upload a sample CSV for an asynchronous import
POST {{baseUrl}}/api/files
Authorization: Bearer {{upmsAccessToken}}
Content-Type: multipart/form-data; boundary=transfer-boundary

--transfer-boundary
Content-Disposition: form-data; name="file"; filename="values.csv"
Content-Type: text/csv

value,label
alpha,Alpha
beta,Beta
--transfer-boundary--

> {%
  client.global.set("importSourceFileId", response.body.data.id);
%}

### Submit an import (demo handler validates rows and writes a report)
POST {{baseUrl}}/api/transfer-tasks/imports
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"handlerKey": "demo-csv-import", "sourceFileId": "{{importSourceFileId}}", "options": {}}

> {%
  client.global.set("importTaskId", response.body.data.id);
%}

### Check import progress; repeat until status is SUCCEEDED
POST {{baseUrl}}/api/transfer-tasks/detail
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"id": "{{importTaskId}}"}

### Get the import report file ID after success
POST {{baseUrl}}/api/transfer-tasks/result
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"id": "{{importTaskId}}"}

### Submit a sample export
POST {{baseUrl}}/api/transfer-tasks/exports
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"handlerKey": "demo-csv-export", "options": {"rows": "5"}}

> {%
  client.global.set("exportTaskId", response.body.data.id);
%}

### List my import/export tasks
POST {{baseUrl}}/api/transfer-tasks/list
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"page": 1, "size": 20}

### Check export progress; repeat until status is SUCCEEDED
POST {{baseUrl}}/api/transfer-tasks/detail
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"id": "{{exportTaskId}}"}

### Get the export result file ID after success; then use /api/files/{id}/content
POST {{baseUrl}}/api/transfer-tasks/result
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"id": "{{exportTaskId}}"}

### Read plaintext personal data (requires sensitive-read permission, scope and durable audit)
# Ordinary user/detail and user/list responses mask realName, email and mobile.
# Grant upms:user:sensitive:read explicitly and obtain a fresh token before using this request.
POST {{baseUrl}}/api/upms/user/sensitive
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"id": "{{upmsUserId}}", "purpose": "CUSTOMER_SUPPORT"}

# Merchant management: merchantCode is a business identifier; contract merchantId is the returned id.
### Create merchant before signing a contract (change merchantCode on repeated runs)
POST {{baseUrl}}/api/merchants/create
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"merchantCode":"HTTP_MERCHANT","name":"HTTP Retail Merchant","shortName":"Retail","type":"ENTERPRISE","industry":"RETAIL","country":"CN","province":"GD","city":"SZ","address":"Example address","registrationNo":"HTTP-REG-001","contactName":"Contact","contactPhone":"13800138000","contactEmail":"merchant@example.com"}

> {%
  client.assert(response.body.result.status === "S", "Create merchant must succeed");
  client.global.set("contractMerchant", response.body.data.id);
  client.global.set("merchantRowVersion", response.body.data.rowVersion);
%}

### Page active merchants
POST {{baseUrl}}/api/merchants/page
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"page":1,"size":20,"status":"ACTIVE"}

### Read masked merchant details
POST {{baseUrl}}/api/merchants/detail
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"id":"{{contractMerchant}}"}

### Update merchant basic data; null private fields preserve the stored value
POST {{baseUrl}}/api/merchants/update
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"id":"{{contractMerchant}}","expectedRowVersion":{{merchantRowVersion}},"merchantCode":"HTTP_MERCHANT","name":"HTTP Retail Merchant Updated","shortName":"Retail","type":"ENTERPRISE","industry":"RETAIL","country":"CN","province":"GD","city":"SZ","address":null,"registrationNo":null,"contactName":null,"contactPhone":null,"contactEmail":null}

> {%
  client.assert(response.body.result.status === "S", "Update merchant must succeed");
  client.global.set("merchantRowVersion", response.body.data.rowVersion);
%}

# Contract management: configure trusted tenant context, MerchantFactsProvider and contract:* permissions first.
# Run once with unique catalog codes; response.result.status must be S before using data.
# This example uses the merchant created above and the merchant-contract adapter.
@contractScope = store1

### Create merchant eligibility condition
POST {{baseUrl}}/api/contract/catalog/save
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{
  "kind": "CONDITION",
  "code": "HTTP_RETAIL",
  "version": 1,
  "definition": {
    "mode": "ALL",
    "clauses": [
      {
        "kind": "COMPARE",
        "negated": false,
        "field": "merchant.industry",
        "operator": "EQ",
        "valueType": "STRING",
        "expected": [
          "RETAIL"
        ],
        "configurationKey": null
      }
    ]
  }
}

> {%
  client.assert(response.body.result.status === "S", "Contract operation must succeed");
  client.global.set("contractConditionId", response.body.data.id);
  client.global.set("contractConditionVersion", response.body.data.rowVersion);
%}

### Publish merchant eligibility condition
POST {{baseUrl}}/api/contract/catalog/publish
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{
  "id": "{{contractConditionId}}",
  "expectedRowVersion": {{contractConditionVersion}}
}

### Create payment product
POST {{baseUrl}}/api/contract/catalog/save
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{
  "kind": "PRODUCT",
  "code": "HTTP_WECHAT",
  "version": 1,
  "definition": {
    "capabilityCode": "payment.collect",
    "parameters": [
      {
        "key": "fee.rate",
        "type": "DECIMAL",
        "required": true,
        "defaultValue": "0.006",
        "minimum": "0.003",
        "maximum": "0.01",
        "allowedValues": [],
        "editableLayers": [
          "BUNDLE",
          "SALES_PLAN",
          "MERCHANT"
        ]
      }
    ],
    "conditionId": null,
    "dependencies": [],
    "exclusions": []
  }
}

> {%
  client.assert(response.body.result.status === "S", "Contract operation must succeed");
  client.global.set("contractProductId", response.body.data.id);
  client.global.set("contractProductVersion", response.body.data.rowVersion);
%}

### Publish payment product
POST {{baseUrl}}/api/contract/catalog/publish
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{
  "id": "{{contractProductId}}",
  "expectedRowVersion": {{contractProductVersion}}
}

