### Read signed terms
POST {{baseUrl}}/api/contract/merchant-contracts/detail
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{
  "id": "{{contractId}}"
}

### Resolve signed payment capability
POST {{baseUrl}}/api/contract/runtime/resolve
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{
  "merchantId": "{{contractMerchant}}",
  "scopeKey": "{{contractScope}}",
  "itemKey": "basic.wechat",
  "transactionFacts": {}
}

### Suspend signed contract
POST {{baseUrl}}/api/contract/merchant-contracts/status
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{
  "id": "{{contractId}}",
  "expectedGeneration": {{contractGeneration}},
  "status": "SUSPENDED"
}

> {%
  client.assert(response.body.result.status === "S", "Contract operation must succeed");
  client.global.set("contractGeneration", response.body.data.generation);
%}

### Resolve suspended contract; allowed must be false
POST {{baseUrl}}/api/contract/runtime/resolve
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{
  "merchantId": "{{contractMerchant}}",
  "scopeKey": "{{contractScope}}",
  "itemKey": "basic.wechat",
  "transactionFacts": {}
}

### Resume signed contract
POST {{baseUrl}}/api/contract/merchant-contracts/status
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{
  "id": "{{contractId}}",
  "expectedGeneration": {{contractGeneration}},
  "status": "NORMAL"
}

> {%
  client.assert(response.body.result.status === "S", "Contract operation must succeed");
  client.global.set("contractGeneration", response.body.data.generation);
%}

### Retire sales plan; existing signed terms remain unchanged
POST {{baseUrl}}/api/contract/catalog/retire
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{
  "id": "{{contractPlanId}}",
  "expectedRowVersion": {{contractPublishedPlanVersion}}
}

### Disable merchant; subsequent contract qualification and runtime fact loading are rejected
POST {{baseUrl}}/api/merchants/status
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"id":"{{contractMerchant}}","expectedRowVersion":{{merchantRowVersion}},"status":"INACTIVE"}

> {%
  client.assert(response.body.result.status === "S", "Disable merchant must succeed");
  client.global.set("merchantRowVersion", response.body.data.rowVersion);
%}

### Re-enable merchant
POST {{baseUrl}}/api/merchants/status
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{"id":"{{contractMerchant}}","expectedRowVersion":{{merchantRowVersion}},"status":"ACTIVE"}
