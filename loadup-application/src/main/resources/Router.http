### Create sales plan
POST {{baseUrl}}/api/contract/catalog/save
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{
  "kind": "SALES_PLAN",
  "code": "HTTP_STANDARD",
  "version": 1,
  "definition": {
    "bundles": [
      {
        "alias": "basic",
        "bundleId": "{{contractBundleId}}"
      }
    ],
    "values": {},
    "merchantPolicies": {
      "basic.wechat": {
        "fee.rate": {
          "minimum": "0.0038",
          "maximum": "0.006",
          "allowedValues": []
        }
      }
    },
    "eligibilityConditionId": "{{contractConditionId}}",
    "usageConditionId": null,
    "saleStartsAt": "2026-01-01T00:00:00Z",
    "saleEndsAt": null
  }
}

> {%
  client.assert(response.body.result.status === "S", "Contract operation must succeed");
  client.global.set("contractPlanId", response.body.data.id);
  client.global.set("contractPlanVersion", response.body.data.rowVersion);
%}

### Publish sales plan
POST {{baseUrl}}/api/contract/catalog/publish
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{
  "id": "{{contractPlanId}}",
  "expectedRowVersion": {{contractPlanVersion}}
}

> {%
  client.assert(response.body.result.status === "S", "Publish must succeed");
  client.global.set("contractPublishedPlanVersion", response.body.data.rowVersion);
%}

### Preview merchant terms without persistence
POST {{baseUrl}}/api/contract/merchant-contracts/preview
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{
  "merchantId": "{{contractMerchant}}",
  "scopeKey": "{{contractScope}}",
  "planVersionId": "{{contractPlanId}}",
  "requestKey": "http-preview",
  "selectedItems": [
    "basic.wechat"
  ],
  "values": {
    "basic.wechat": {
      "fee.rate": "0.0045"
    }
  },
  "effectiveFrom": null,
  "effectiveTo": null
}

### Sign merchant contract; preserve the generated key when retrying
< {%
  if (!client.global.get("contractSigningKey")) client.global.set("contractSigningKey", "http-" + Date.now().toString());
%}
POST {{baseUrl}}/api/contract/merchant-contracts/sign
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{
  "merchantId": "{{contractMerchant}}",
  "scopeKey": "{{contractScope}}",
  "planVersionId": "{{contractPlanId}}",
  "requestKey": "{{contractSigningKey}}",
  "selectedItems": [
    "basic.wechat"
  ],
  "values": {
    "basic.wechat": {
      "fee.rate": "0.0045"
    }
  },
  "effectiveFrom": null,
  "effectiveTo": null
}

> {%
  client.assert(response.body.result.status === "S", "Contract operation must succeed");
  client.global.set("contractId", response.body.data.id);
  client.global.set("contractGeneration", response.body.data.generation);
%}

### Replay the same signing request
POST {{baseUrl}}/api/contract/merchant-contracts/sign
Authorization: Bearer {{upmsAccessToken}}
Content-Type: application/json

{
  "merchantId": "{{contractMerchant}}",
  "scopeKey": "{{contractScope}}",
  "planVersionId": "{{contractPlanId}}",
  "requestKey": "{{contractSigningKey}}",
  "selectedItems": [
    "basic.wechat"
  ],
  "values": {
    "basic.wechat": {
      "fee.rate": "0.0045"
    }
  },
  "effectiveFrom": null,
  "effectiveTo": null
}

